---
import Categories from "./Categories.astro";
import MusicPlayer from "./MusicPlayer.astro";
import Profile from "./Profile.astro";
import Tags from "./Tags.astro";

interface Props {
  class?: string;
}

const className = Astro.props.class;
---

<aside id="sidebar" class:list={[className, "w-full"]}>
  <div class="mb-4 flex w-full flex-col gap-4">
    <Profile />
  </div>
  <div
    id="sidebar-sticky"
    class="sticky top-4 flex w-full flex-col gap-4 transition-all duration-700"
  >
    <div
      class="contents"
      th:each="widget, widgetStat : ${theme.config.sidebar.widgets}"
    >
      <div class="contents" th:switch="${widget.value}">
        <div class="contents" th:case="'categories'">
          <Categories class="onload-animation" />
        </div>
        <div class="contents" th:case="'tag'">
          <Tags class="onload-animation" />
        </div>
        <div class="contents" th:case="'music'">
          <MusicPlayer
            class="onload-animation"
            th:style="|animation-delay: calc(var(--content-delay) + ${widgetStat.index * 50}ms)|"
          />
        </div>
        <div class="contents" th:case="'archives'">
          <div
            class="card-base pb-4 onload-animation"
            th:style="|animation-delay: calc(var(--content-delay) + ${widgetStat.index * 50}ms)|"
            th:with="recentPosts = ${postFinder.list(1, 10)}"
          >
            <div
              class="relative mb-2 ml-8 mt-4 text-lg font-bold text-neutral-900 transition before:absolute before:left-[-16px] before:top-[5.5px] before:h-4 before:w-1 before:rounded-md before:bg-(--primary) dark:text-neutral-100"
              th:text="#{widget.archives.title}"
            >
              Archives
            </div>
            <div class="overflow-hidden px-4">
              <a
                th:each="post : ${recentPosts.items}"
                th:href="@{${post.status.permalink}}"
                class="group block"
              >
                <div
                  class="h-10 rounded-lg pl-2 transition-all group-hover:bg-(--btn-plain-bg-hover) group-hover:pl-3 group-active:bg-(--btn-plain-bg-active)"
                >
                  <div
                    class="relative mr-2 flex h-full items-center justify-between"
                  >
                    <span
                      class="overflow-hidden overflow-ellipsis whitespace-nowrap text-left text-sm text-neutral-700 transition group-hover:text-(--primary) dark:text-neutral-300 dark:group-hover:text-(--primary)"
                      th:text="${post.spec.title}"
                    >
                      Post
                    </span>
                    <span
                      class="ml-2 flex-shrink-0 text-xs text-neutral-400"
                      th:text="${#dates.format(post.spec.publishTime, 'MM-dd')}"
                    >
                      01-01
                    </span>
                  </div>
                </div>
              </a>
            </div>
            <a
              th:href="@{/archives}"
              class="mx-4 mt-1 block text-center text-sm font-bold text-(--primary) transition hover:underline"
              th:text="#{widget.archives.viewAll}"
            >
              View All
            </a>
          </div>
        </div>
        <div
          th:case="'html'"
          class="card-base onload-animation p-4"
          th:utext="${widget.html}"
        >
        </div>
      </div>
    </div>
  </div>
</aside>
