---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import VideoCinema from "../components/video/VideoCinema.astro";
import MusicLibrary from "../components/music/MusicLibrary.astro";
---

<MainGridLayout
  title="${singlePage.spec.title + ' - ' + site.title}"
  setOGTypeArticle={true}
  showToc={true}
  wideExpression="${singlePage.metadata.name == 'music' or singlePage.spec.slug == 'music'}"
>
  <Fragment slot="head">
    <title th:text="${singlePage.spec.title + ' - ' + site.title}"></title>
    <meta
      th:if="${singlePage.spec.slug == 'videos' or singlePage.spec.slug == 'video'}"
      name="referrer"
      content="no-referrer"
    />
  </Fragment>

  <!-- Video Cinema -->
  <div
    th:if="${singlePage.metadata.name == 'videos' or singlePage.metadata.name == 'video' or singlePage.spec.slug == 'videos' or singlePage.spec.slug == 'video'}"
  >
    <VideoCinema />
  </div>

  <!-- Music Library -->
  <div
    th:if="${singlePage.metadata.name == 'music' or singlePage.spec.slug == 'music'}"
  >
    <MusicLibrary />

    <section
      id="music-wishlist"
      class="card-base relative z-10 mb-4 w-full px-6 pb-4 pt-6 md:px-9"
      th:if="${haloCommentEnabled}"
    >
      <h2
        class="mb-1 text-xl font-bold text-90"
        th:text="#{page.music.wishlistTitle}"
      >
        Song wishlist
      </h2>
      <p
        class="mb-4 text-sm text-50"
        th:text="#{page.music.wishlistDescription}"
      >
        Tell me what songs you want to hear here.
      </p>
      <Fragment
        set:html={'<halo:comment group="content.halo.run" kind="SinglePage" th:attr="name=${singlePage.metadata.name}" />'}
      />
    </section>
  </div>

  <!-- Normal page content -->
  <article
    th:if="${singlePage.metadata.name != 'videos' and singlePage.metadata.name != 'video' and singlePage.spec.slug != 'videos' and singlePage.spec.slug != 'video' and singlePage.metadata.name != 'music' and singlePage.spec.slug != 'music'}"
    class="card-base relative z-10 mb-4 w-full px-6 pb-8 pt-7 md:px-9"
  >
    <h1
      class="onload-animation relative mb-5 text-3xl font-bold text-black/90 transition before:absolute before:-left-4.5 before:top-3 before:h-5 before:w-1 before:rounded-md before:bg-(--primary) dark:text-white/90 md:text-[2.25rem]/[2.75rem]"
      th:text="${singlePage.spec.title}"
    >
      Page title
    </h1>
    <div
      id="content"
      class="custom-md markdown-content onload-animation prose prose-base max-w-none! dark:prose-invert!"
      th:classappend="| ${theme.config.post.content_size} ${theme.config.post.content_theme}|"
      th:utext="${singlePage.content.content}"
    >
    </div>
  </article>
</MainGridLayout>
